{
  "name": "artchronos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/server/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration tests/acceptance",
    "db:migrate": "tsx src/infrastructure/db/migrate-cli.ts",
    "db:seed": "tsx src/infrastructure/db/seed-cli.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "trace:check": "python3 tools/build_traceability.py --check",
    "check": "npm run typecheck && npm run lint && npm run deps:check && npm run test",
    "test:e2e": "playwright test",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=validation/test-results.json"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "adminjs": "^7.8.17",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "express": "^4.22.3",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adminjs/bundler": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
